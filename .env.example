# Copy to .env and fill in. Everything is optional.

# PostgreSQL (recommended). Without it the app uses a local SQLite file.
DATABASE_URL=postgresql://stt:stt@localhost:5432/stt

# Gemini Live - free key from https://aistudio.google.com/apikey
# If empty, users can paste their own key in the app's Settings dialog.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# Alternatives: gemini-3.1-flash-live-preview, gemini-3.8-live

# Self-hosted open-source engine (faster-whisper on CPU)
WHISPER_ENABLED=true
WHISPER_MODEL=small        # tiny | base | small | medium | large-v3
WHISPER_COMPUTE_TYPE=int8
WHISPER_PRELOAD=true

DEFAULT_ENGINE=gemini
